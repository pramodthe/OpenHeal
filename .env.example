OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
COMPOSIO_API_KEY=
TRUEFORGE_BASE_URL=http://localhost:8790
TRUEFORGE_MODEL=openai/gpt-5.6-luna
DEMO_OFFLINE=
GITHUB_TOKEN=
GITHUB_PERSONAL_ACCESS_TOKEN=
DAYTONA_API_KEY=
DAYTONA_SERVER_URL=
DAYTONA_TARGET=
OPENHEAL_LLM_MODEL=openai/gpt-5.6-luna
HITL_SECRET_KEY=

# --- TrueForge harness ---
# Must match a name from GET /api/v1/models on the TrueForge server.
# Dotted spellings (gpt-5.6-luna) are auto-corrected to the catalog form.
TRUEFORGE_TOKEN=

# --- Composio GitHub MCP + triggers ---
# Reused if present; otherwise created on first run.
COMPOSIO_MCP_CONFIG_ID=
# Verifies inbound webhook signatures. Unset = parsed but unverified.
COMPOSIO_WEBHOOK_SECRET=
# Public HTTPS origin for Composio webhooks. Options:
#   1. Run `npm run tunnel` in another terminal (writes .openheal-tunnel-url)
#   2. Set this manually to your tunnel URL
OPENHEAL_PUBLIC_URL=
# Loop guard: the GitHub login OpenHeal pushes as. Events from it are ignored.
OPENHEAL_BOT_LOGIN=
# Only issues carrying this label are healed. Default: openheal
OPENHEAL_ISSUE_LABEL=openheal
# Local persistence for enrolled repos, run history, and turn traces
OPENHEAL_DATA_DIR=.openheal-data

# --- Optional: Langfuse turn tracing (https://langfuse.com) ---
# When set, each TrueForge turn event is mirrored to Langfuse as spans.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
